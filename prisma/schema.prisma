generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  RESIDENT
  GUARD
  ADMIN
}

enum PassStatus {
  PENDING
  ACTIVE
  REJECTED
  INSIDE
  EXITED
  EXPIRED
}

enum AccessAction {
  IN
  OUT
}

model User {
  id           String           @id @default(uuid())
  fullName     String
  phoneNumber  String           @unique
  houseNumber  String?
  password     String
  role         Role             @default(RESIDENT)
  isActive     Boolean          @default(true)
  otpCode      String?
  otpExpires   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  passes       VisitorPass[]    @relation("ResidentPasses")
  guardLogs    AccessLog[]      @relation("GuardLogs")
  blockedUsers BlockedVisitor[] @relation("AdminBlocked")
}

model VisitorPass {
  id            String       @id @default(uuid())
  residentId    String
  resident      User         @relation("ResidentPasses", fields: [residentId], references: [id])
  visitorName   String
  visitorPhone  String
  purpose       String
  visitDateTime DateTime
  qrToken       String       @unique
  status        PassStatus   @default(ACTIVE)
  expiresAt     DateTime
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  logs          AccessLog[]
}

model AccessLog {
  id          String       @id @default(uuid())
  passId      String
  pass        VisitorPass  @relation(fields: [passId], references: [id])
  guardId     String
  guard       User         @relation("GuardLogs", fields: [guardId], references: [id])
  visitorName String
  gateName    String       @default("Main Gate")
  action      AccessAction @default(IN)
  timestamp   DateTime     @default(now())
}

model BlockedVisitor {
  id          String   @id @default(uuid())
  fullName    String
  phoneNumber String   @unique
  reason      String   @default("Security violation")
  blockedById String?
  blockedBy   User?    @relation("AdminBlocked", fields: [blockedById], references: [id])
  blockedDate DateTime @default(now())
}

model EstateSetting {
  id                            Int      @id @default(1)
  estateName                    String   @default("Estate Access Community")
  passExpiryHours               Int      @default(2)
  requireResidentApprovalAtGate Boolean  @default(false)
  estateRules                   String[] @default(["All visitors must present a valid QR pass at the Main Gate.", "Delivery riders are restricted to designated drop-off hours (7:00 AM - 9:00 PM).", "Speed limit within the estate is 20 km/h."])
  notificationsEnabled          Boolean  @default(true)
}
